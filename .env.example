# LLM Configuration (Member 3)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.0-flash

# Voice briefing TTS model (Member 3) -- reuses LLM_API_KEY, no separate key needed.
# Only used as a fallback; see GOOGLE_TTS_API_KEY below for the preferred path.
TTS_MODEL=gemini-3.8-flash-tts

# Voice briefing (preferred): Cloud Text-to-Speech API key -- a separate GCP
# product/credential from LLM_API_KEY, with its own billing and quota (doesn't hit the
# Gemini free tier's 10-requests/day cap). Enable "Cloud Text-to-Speech API" in Google
# Cloud Console, create an API key for it, and put it here. Optional: if unset, voice
# briefing falls back to Gemini's native TTS via LLM_API_KEY/TTS_MODEL above.
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here

# Operational Mode (auto | cache | live)
DEMO_MODE=auto

# Predictive Auto-Heal (Member 2 & 3)
PREDICTIVE_HEAL=off
DEBUG=0
SIM_FORCE_PROBE_FAIL=0 # integration test only

# Autonomy Level (1: human approves all | 2: low-risk auto, high-risk asks | 3: auto-remediate)
AUTONOMY_LEVEL=2

# Infrastructure Adapter (simulator | k8s)
ADAPTER=simulator

# Telegram Bot Integration (Member 4)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Service URLs
BACKEND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Financial Impact / Downtime Ticker (cost per minute)
VITE_COST_PER_MINUTE=<placeholder>

# Simulator-only optional variables
# SIM_SPEED=1 (playback speed multiplier)
SIM_SPEED=1
# SIM_STEP_DELAY_S=2.0 (seconds each simulated restart/patch takes)
SIM_STEP_DELAY_S=2.0

# Executor (Member 2)
# EXEC_POLL_S=0.25 (seconds between health-probe polls while a playbook step is verified)
EXEC_POLL_S=0.25
