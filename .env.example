# LLM Configuration (Member 3)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.0-flash

# Operational Mode
# DEMO_MODE: auto (live, cache on failure) | cache (offline guaranteed) | live
DEMO_MODE=auto

# Autonomy Level (1: human approves all | 2: low-risk auto, high-risk asks | 3: auto-remediate)
AUTONOMY_LEVEL=2

# Infrastructure Adapter (simulator | k8s)
ADAPTER=simulator

# Telegram Bot Integration (Member 4)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# URLs
BACKEND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_URL=http://localhost:8000/api

# Financial Impact / Downtime Ticker (₹ per minute)
VITE_COST_PER_MINUTE=1200
